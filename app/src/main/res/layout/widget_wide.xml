<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 widget, and either widget at MediaWidget.WIDE_LAYOUT_MIN_DP or wider: the cover on the left, in its
  own colour, going out in rings round the keys as Now Playing's film goes out round the dial, and the song in
  the black on the right, set as Now Playing sets it: its name in Montserrat's capitals, its artists in the
  book serif, and the keys. The cover and its rings are one picture (WidgetArt): a widget can't draw either.
  The words and keys start where the cover ends (MediaWidget sets the padding to the widget's height).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/widget_wide_panel_start"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/eb_garamond"
            android:fontVariationSettings="'wght' 400"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_artist"
            android:textColor="#FF9A9A9A"
            android:textSize="14.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="@dimen/widget_key_wide"
                android:layout_height="@dimen/widget_key_wide"
                android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_previous"
                android:padding="@dimen/widget_key_wide_glyph"
                android:src="@drawable/widget_previous" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="@dimen/widget_key_wide_play"
                android:layout_height="@dimen/widget_key_wide_play"
                android:layout_marginStart="@dimen/widget_key_wide_gap"
                android:layout_marginEnd="@dimen/widget_key_wide_gap"
                android:background="@drawable/widget_key_lit"
                android:contentDescription="@string/widget_play"
                android:padding="@dimen/widget_key_wide_play_glyph"
                android:src="@drawable/widget_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="@dimen/widget_key_wide"
                android:layout_height="@dimen/widget_key_wide"
                android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_next"
                android:padding="@dimen/widget_key_wide_glyph"
                android:src="@drawable/widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
