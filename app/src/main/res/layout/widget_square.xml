<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2×2 widget, and either widget narrower than MediaWidget.WIDE_LAYOUT_MIN_DP: the cover filling it, going
  out in rings toward its foot as Now Playing's film goes out round the dial, and in the black there the song's
  name, as Now Playing sets it, over the three keys. One line: a square this size carries one legibly.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_preview_title"
            android:textAllCaps="true"
            android:textColor="#FFFFFFFF"
            android:textSize="10.5sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="@dimen/widget_key_square"
                android:layout_height="@dimen/widget_key_square"
                android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_previous"
                android:padding="@dimen/widget_key_square_glyph"
                android:src="@drawable/widget_previous" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="@dimen/widget_key_square_play"
                android:layout_height="@dimen/widget_key_square_play"
                android:layout_marginStart="@dimen/widget_key_square_gap"
                android:layout_marginEnd="@dimen/widget_key_square_gap"
                android:background="@drawable/widget_key_lit"
                android:contentDescription="@string/widget_play"
                android:padding="@dimen/widget_key_square_play_glyph"
                android:src="@drawable/widget_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="@dimen/widget_key_square"
                android:layout_height="@dimen/widget_key_square"
                android:background="@drawable/widget_key"
                android:contentDescription="@string/widget_next"
                android:padding="@dimen/widget_key_square_glyph"
                android:src="@drawable/widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
